{
  "title": "Minecraft Overview",
  "uid": "minecraft-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Server Status",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_healthy{server_host=\"papermc\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Players Online / Max",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_players_online_count{server_host=\"papermc\"})", "refId": "A", "legendFormat": "Online" },
        { "expr": "max by (server_host) (minecraft_status_players_max_count{server_host=\"papermc\"})", "refId": "B", "legendFormat": "Max" }
      ]
    },
    {
      "id": 3,
      "title": "Response Time",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_response_time_seconds{server_host=\"papermc\"})", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "mc-router Rate Limit Available",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "mc_router_rate_limit_available", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "CPU Load (Pi)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "node_load1", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Memory Available (Pi)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "REPLACE_WITH_YOUR_PROMETHEUS_DATASOURCE_NAME" },
      "targets": [
        { "expr": "node_memory_MemAvailable_bytes", "refId": "A" }
      ]
    }
  ]
}
