# docker/cloud/.env として保存する（Raspberry Pi 側）
# compose は「compose.yml と同じディレクトリの .env」しか自動で読まないため、
# リポジトリルートではなくここに置くこと。

# --- Minecraft サーバー ---

# playit.gg のトンネルエージェント用シークレットキー（必須）
PLAYIT_SECRET_KEY=...

# backup コンテナが rcon で save-off/save-all を打つために固定する（必須）。
# 未設定だと itzg イメージが起動ごとにランダム生成し、backup 側と一致しない。
# 変更後は papermc コンテナの再作成が必要（restart ではなく up -d）。
RCON_PASSWORD=...

# ワールドデータの実体。papermc と backup の両方がここを見る。
# 未設定ならリポジトリルートの ./data。相対パスは compose.yml のある場所が基準。
# 推奨はリポジトリの外、できれば SSD/NVMe 上。
# 理由と移行手順は docs/operations.md の「ワールドデータの配置場所」を参照。
#MC_DATA_DIR=/mnt/ssd/minecraft

# mc-router が 25565 を待ち受けるアドレス。既定の 127.0.0.1 なら playit.gg 経由のみ。
#MC_BIND_IP=0.0.0.0

# 使うときだけ papermc を起動する（scale to zero）。既定で有効。
# false にすると常時起動に戻る。
#AUTO_SCALE=false
# 最後のプレイヤーが抜けてから停止するまでの時間
#AUTO_SCALE_DOWN_AFTER=30m

# --- バックアップ (docker compose run --rm backup) ---

# tar を作る一時置き場。R2 へ転送し終わるとローカル分は削除されるので溜まらない。
# 未設定ならリポジトリルートの ./backups。
#BACKUP_DIR=/mnt/ssd/minecraft-backups

# R2 側で、この日数より古いバックアップを削除する
# （ローカルは転送のたびに消えるので対象外）
RETENTION_DAYS=7

# 資格情報は R2 ダッシュボード → 「Manage R2 API Tokens」で発行する
R2_ENDPOINT=https://<アカウントID>.r2.cloudflarestorage.com
R2_BUCKET=minecraft-backup
R2_PREFIX=world
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# --- Grafana Cloud ---

GRAFANA_CLOUD_PROM_URL=https://prometheus-xxx.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=123456
GRAFANA_CLOUD_LOKI_URL=https://logs-xxx.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=654321
GRAFANA_CLOUD_API_KEY=glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
