{
  "title": "mc-monitor",
  "uid": "mc-monitor",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Server Status",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_healthy{server_host=\"papermc\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Players Online",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_players_online_count{server_host=\"papermc\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20
        }
      }
    },
    {
      "id": 3,
      "title": "Response Time (s)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_response_time_seconds{server_host=\"papermc\"})", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Max Players",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_players_max_count{server_host=\"papermc\"})", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Server Status Over Time",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_healthy{server_host=\"papermc\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Players Online (history)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_players_online_count{server_host=\"papermc\"})", "refId": "A", "legendFormat": "online" },
        { "expr": "max by (server_host) (minecraft_status_players_max_count{server_host=\"papermc\"})", "refId": "B", "legendFormat": "max" }
      ]
    },
    {
      "id": 7,
      "title": "Response Time (history)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        { "expr": "max by (server_host) (minecraft_status_response_time_seconds{server_host=\"papermc\"})", "refId": "A" }
      ]
    }
  ]
}
