{
  "title": "papermc-profiles",
  "uid": "papermc-profiles",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "CPU (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"papermc\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory allocation rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "queryType": "metrics",
          "profileTypeId": "memory:alloc_in_new_tlab_bytes:bytes:space:bytes",
          "labelSelector": "{service_name=\"papermc\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 3,
      "title": "Memory allocation count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
          "queryType": "metrics",
          "profileTypeId": "memory:alloc_in_new_tlab_objects:count:space:bytes",
          "labelSelector": "{service_name=\"papermc\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
